# Build stage
FROM golang:1.21-alpine AS builder
WORKDIR /app
COPY go.mod ./
# Download dependencies
RUN go mod download || true
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o sentinel-worker ./cmd/worker

# Run stage
FROM alpine:latest
RUN apk --no-cache add ca-certificates
WORKDIR /app
COPY --from=builder /app/sentinel-worker .
CMD ["./sentinel-worker"]
